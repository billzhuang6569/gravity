# 代理设置示例
# 如果设置为空，则不使用代理
# VPS示例：
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809

HTTP_PROXY=
HTTPS_PROXY=

# 需要使用代理的网站域名（用逗号分隔）
PROXY_DOMAINS=youtube.com,youtu.be,vimeo.com,dailymotion.com,twitch.tv,facebook.com,instagram.com,twitter.com,x.com

# Cookies设置 - 用于绕过YouTube等网站的机器人验证
# 支持的浏览器: chrome, firefox, safari, edge, opera, brave
# 如果设置为空，则不使用cookies
# Mac示例: COOKIES_BROWSER=chrome
# Linux示例: COOKIES_BROWSER=firefox
COOKIES_BROWSER=

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8018 